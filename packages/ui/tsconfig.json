{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "../../tsconfig.json"
  ],
  "include": [
    "env.d.ts",
    "src/**/*",
    "**/*.vue",
    "index.ts",
    "**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "references": [
    {
      "path": "./tsconfig.storybook.json"
    }
  ]
}